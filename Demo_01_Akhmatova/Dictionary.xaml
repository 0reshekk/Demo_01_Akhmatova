<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Основной фон #FFFFFF
        Дополнительный фон #F4E8D3
        Акцентирование внимания #67BA80
        шрифт Segoe UI
    -->
    <Color x:Key="PrimaryTextColor">#FF37474F</Color>
    <Color x:Key="SecondaryTextColor">#FF78909C</Color>
    <Color x:Key="AccentColor">#67BA80</Color>
    <Color x:Key="BackgroundColor">#FFFFFF</Color>
    <Color x:Key="SecondBackgroundColor">#F4E8D3</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="LightBackgroundColor">#FFF5F5F5</Color>
    <Color x:Key="BorderColor">#FFE0E0E0</Color>
    <Color x:Key="LightAccentColor">#FFDFF3E6</Color>
    <Color x:Key="LightPrimaryColor">#FFE8F5EE</Color>
    <Color x:Key="ErrorColor">#FFD32F2F</Color>
    <Color x:Key="SuccessColor">#FF388E3C</Color>
    <Color x:Key="WarningColor">#FFF9A825</Color>
    <Color x:Key="SecondaryColor">#FF90A4AE</Color>
    <Color x:Key="LightTextColor">#FFFAFAFA</Color>
    <Color x:Key="LightGrayColor">#FFF0F0F0</Color>
    <Color x:Key="DarkTextColor">#FF263238</Color>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource WhiteColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SecondBackgroundBrush" Color="{StaticResource SecondBackgroundColor}" />

    <SolidColorBrush x:Key="LightBackgroundBrush" Color="{StaticResource LightBackgroundColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="LightAccentBrush" Color="{StaticResource LightAccentColor}" />
    <SolidColorBrush x:Key="LightPrimaryBrush" Color="{StaticResource LightPrimaryColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="LightTextBrush" Color="{StaticResource LightTextColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="LightGrayBrush" Color="{StaticResource LightGrayColor}" />
    <SolidColorBrush x:Key="DarkTextBrush" Color="{StaticResource DarkTextColor}" />

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>

    <Style TargetType="Page">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="Margin" Value="16,8" />
    </Style>

    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="{StaticResource LightPrimaryBrush}" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="10,0" />
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource LightBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="16" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
    </Style>

</ResourceDictionary>