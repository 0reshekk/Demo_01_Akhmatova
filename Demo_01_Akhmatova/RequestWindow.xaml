<Window
    x:Class="Demo_01_Akhmatova.RequestWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Demo_01_Akhmatova"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding WindowTitle}"
    Width="720"
    Height="640"
    Icon="/source/icon.ico"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Padding="16" Background="{StaticResource SecondBackgroundBrush}">
            <TextBlock Style="{StaticResource LargeHeaderStyle}" Text="{Binding WindowTitle}" />
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource HeaderStyle}"
                    Text="Данные заявки" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Style="{StaticResource SubHeaderStyle}"
                    Text="Адрес" />
                <ComboBox
                    Grid.Row="1"
                    Grid.Column="1"
                    DisplayMemberPath="AddressLine"
                    ItemsSource="{Binding Addresses}"
                    SelectedItem="{Binding SelectedAddress}" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Style="{StaticResource SubHeaderStyle}"
                    Text="ФИО заявителя" />
                <TextBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Style="{StaticResource TextBoxFieldStyle}"
                    Text="{Binding ApplicantName}" />

                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    Style="{StaticResource SubHeaderStyle}"
                    Text="Контактный телефон" />
                <TextBox
                    Grid.Row="3"
                    Grid.Column="1"
                    Style="{StaticResource TextBoxFieldStyle}"
                    Text="{Binding Phone}" />

                <TextBlock
                    Grid.Row="4"
                    Grid.Column="0"
                    Style="{StaticResource SubHeaderStyle}"
                    Text="Описание проблемы" />
                <TextBox
                    Grid.Row="4"
                    Grid.Column="1"
                    Style="{StaticResource MultilineTextBoxStyle}"
                    Text="{Binding Description}" />

                <TextBlock
                    Grid.Row="5"
                    Grid.Column="0"
                    Style="{StaticResource SubHeaderStyle}"
                    Text="Ответственный исполнитель" />
                <ComboBox
                    Grid.Row="5"
                    Grid.Column="1"
                    DisplayMemberPath="FullName"
                    ItemsSource="{Binding Employees}"
                    SelectedItem="{Binding SelectedEmployee}" />

                <TextBlock
                    Grid.Row="6"
                    Grid.Column="0"
                    Style="{StaticResource SubHeaderStyle}"
                    Text="Статус заявки" />
                <ComboBox
                    Grid.Row="6"
                    Grid.Column="1"
                    ItemsSource="{Binding StatusOptions}"
                    SelectedItem="{Binding SelectedStatus}" />
            </Grid>
        </ScrollViewer>
        <StackPanel
            Grid.Row="2"
            Margin="16"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Click="SaveClick"
                Content="Сохранить"
                Style="{StaticResource ActionButtonStyle}" />
            <Button Click="CancelClick" Content="Отмена" />
        </StackPanel>
    </Grid>
</Window>