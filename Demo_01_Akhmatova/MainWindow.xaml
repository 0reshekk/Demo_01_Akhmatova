<Window
    x:Class="Demo_01_Akhmatova.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Demo_01_Akhmatova"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Управление заявками"
    Width="1100"
    Height="720"
    Icon="/source/icon.ico"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="12" Background="{StaticResource SecondBackgroundBrush}">
            <DockPanel>
                <Image
                    Width="50"
                    Height="50"
                    Margin="8,0"
                    Source="/source/logo.png"
                    Stretch="Uniform" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="20"
                    FontWeight="Bold"
                    Text="Управляющая компания • Заявки на обслуживание" />
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="16">
            <TabItem Header="Заявки">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button
                            Click="AddRequestClick"
                            Content="Добавить"
                            Style="{StaticResource ActionButtonStyle}" />
                        <Button
                            Click="EditRequestClick"
                            Content="Редактировать"
                            Style="{StaticResource ActionButtonStyle}" />
                        <Button Click="DeleteRequestClick" Content="Удалить" />
                    </StackPanel>

                    <ListView
                        Grid.Row="1"
                        Margin="8"
                        ItemsSource="{Binding Requests}"
                        PreviewMouseLeftButtonUp="RequestListClick"
                        SelectedItem="{Binding SelectedRequest}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn
                                    Width="50"
                                    DisplayMemberBinding="{Binding Id}"
                                    Header="№" />
                                <GridViewColumn
                                    Width="220"
                                    DisplayMemberBinding="{Binding AddressDisplay}"
                                    Header="Адрес" />
                                <GridViewColumn
                                    Width="160"
                                    DisplayMemberBinding="{Binding ApplicantName}"
                                    Header="Заявитель" />
                                <GridViewColumn
                                    Width="130"
                                    DisplayMemberBinding="{Binding Phone}"
                                    Header="Телефон" />
                                <GridViewColumn
                                    Width="180"
                                    DisplayMemberBinding="{Binding EmployeeDisplay}"
                                    Header="Исполнитель" />
                                <GridViewColumn
                                    Width="90"
                                    DisplayMemberBinding="{Binding Status}"
                                    Header="Статус" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <TabItem Header="Адреса">
                <ListView Margin="8" ItemsSource="{Binding Addresses}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn
                                Width="400"
                                DisplayMemberBinding="{Binding AddressLine}"
                                Header="Адрес" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>

            <TabItem Header="Сотрудники">
                <ListView Margin="8" ItemsSource="{Binding Employees}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn
                                Width="260"
                                DisplayMemberBinding="{Binding FullName}"
                                Header="ФИО" />
                            <GridViewColumn
                                Width="160"
                                DisplayMemberBinding="{Binding Position}"
                                Header="Должность" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>

            <TabItem Header="История">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <GroupBox Margin="8" Header="История по сотруднику">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SubHeaderStyle}" Text="Выберите сотрудника" />
                                <ComboBox
                                    DisplayMemberPath="FullName"
                                    ItemsSource="{Binding EmployeeFilters}"
                                    SelectedItem="{Binding SelectedEmployeeFilter}" />
                                <ListView Margin="8" ItemsSource="{Binding FilteredRequestsByEmployee}">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn
                                                Width="50"
                                                DisplayMemberBinding="{Binding Id}"
                                                Header="№" />
                                            <GridViewColumn
                                                Width="200"
                                                DisplayMemberBinding="{Binding AddressDisplay}"
                                                Header="Адрес" />
                                            <GridViewColumn
                                                Width="140"
                                                DisplayMemberBinding="{Binding ApplicantName}"
                                                Header="Заявитель" />
                                            <GridViewColumn
                                                Width="240"
                                                DisplayMemberBinding="{Binding Description}"
                                                Header="Описание" />
                                            <GridViewColumn
                                                Width="90"
                                                DisplayMemberBinding="{Binding Status}"
                                                Header="Статус" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Margin="8" Header="История по адресу">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SubHeaderStyle}" Text="Выберите адрес" />
                                <ComboBox
                                    DisplayMemberPath="AddressLine"
                                    ItemsSource="{Binding AddressFilters}"
                                    SelectedItem="{Binding SelectedAddressFilter}" />
                                <ListView Margin="8" ItemsSource="{Binding FilteredRequestsByAddress}">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn
                                                Width="50"
                                                DisplayMemberBinding="{Binding Id}"
                                                Header="№" />
                                            <GridViewColumn
                                                Width="180"
                                                DisplayMemberBinding="{Binding EmployeeDisplay}"
                                                Header="Исполнитель" />
                                            <GridViewColumn
                                                Width="140"
                                                DisplayMemberBinding="{Binding ApplicantName}"
                                                Header="Заявитель" />
                                            <GridViewColumn
                                                Width="260"
                                                DisplayMemberBinding="{Binding Description}"
                                                Header="Описание" />
                                            <GridViewColumn
                                                Width="90"
                                                DisplayMemberBinding="{Binding Status}"
                                                Header="Статус" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2">
            <StatusBarItem Content="Готово к работе" />
        </StatusBar>
    </Grid>
</Window>